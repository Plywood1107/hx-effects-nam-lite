{
  "id": "hostprobe",
  "display_name": "Probe",
  "parameters": [
    {"id": "time", "display": "Time", "type": "continuous", "min": 0.1, "max": 4, "default": 0.5, "unit": "s (the host's synced Time; not used)", "smoothing": "immediate"},
    {"id": "mode", "display": "Mode", "type": "integer", "min": 0, "max": 1, "default": 0, "unit": "0 Report (the data burst), 1 Pass (the input)", "smoothing": "immediate"},
    {"id": "level", "display": "Level", "type": "continuous", "min": 0, "max": 1, "default": 0.25, "unit": "x: the burst's peak (shown as %)", "smoothing": "immediate"}
  ]
}
